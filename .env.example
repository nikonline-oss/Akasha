# Akasha deployment env (см. doc/deployment.md)

# Порт и привязка веб-интерфейса (docker-compose).
# AKASHA_PORT — порт и внутри контейнера, и на хосте.
# AKASHA_HOST — какой адрес хоста слушать: 127.0.0.1 = только через reverse-proxy (рекомендуется),
#               0.0.0.0 = открыть напрямую (если порт уже занят другим сервисом, поменяйте AKASHA_PORT).
AKASHA_PORT=8080
AKASHA_HOST=127.0.0.1

AKASHA_DB_PASSWORD=change-me
AKASHA_OWNER_EMAIL=you@example.com
# пусто = сгенерировать временный пароль при первом запуске
AKASHA_OWNER_PASSWORD=
# Ключ для AES-GCM шифрования секретов (сгенерируйте, например: openssl rand -base64 32)
AKASHA_MASTER_KEY=
# Telegram approvals bot (опционально)
AKASHA_TELEGRAM_BOT_TOKEN=
AKASHA_TELEGRAM_CHAT_ID=

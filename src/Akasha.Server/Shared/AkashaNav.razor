@inject AppState AppState
@implements IDisposable

<MudAppBar Elevation="2" Color="Color.Primary">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                   OnClick="@ToggleDrawer" Class="mr-2" Title="@Loc.T("nav.menu")" />
    <MudText Typo="Typo.h6" Color="Color.Inherit">✦ Akasha</MudText>
    <MudSpacer />
    <MudTooltip Text="RU / EN">
        <MudIconButton Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" OnClick="@ToggleLanguage" />
    </MudTooltip>
    <MudTooltip Text="@Loc.T("settings.dark")">
        <MudIconButton Icon="@ThemeIcon" Color="Color.Inherit" OnClick="@ToggleTheme" />
    </MudTooltip>
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add" Href="/entries" Class="mr-2">@Loc.T("nav.newEntry")</MudButton>
    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Logout" Href="/logout">@Loc.T("nav.logout")</MudButton>
</MudAppBar>

<MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Elevation="3">
    <MudDrawerHeader Class="px-4 py-4" Style="background:var(--mud-palette-appbar-background);">
        <MudText Typo="Typo.h6" Color="Color.Inherit">✦ Akasha</MudText>
        <MudText Typo="Typo.caption" Color="Color.Inherit">@Loc.T("nav.tagline")</MudText>
    </MudDrawerHeader>
    <MudNavMenu Class="pa-2">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@Loc.T("nav.dashboard")</MudNavLink>
        <MudNavLink Href="/projects" Icon="@Icons.Material.Filled.Folder">@Loc.T("nav.projects")</MudNavLink>
        <MudNavLink Href="/search" Icon="@Icons.Material.Filled.Search">@Loc.T("nav.search")</MudNavLink>
        <MudNavLink Href="/graph" Icon="@Icons.Material.Filled.Hub">@Loc.T("nav.graph")</MudNavLink>
        <MudNavLink Href="/approvals" Icon="@Icons.Material.Filled.Approval">@Loc.T("nav.approvals")</MudNavLink>
        <MudNavLink Href="/scripts" Icon="@Icons.Material.Filled.Code">@Loc.T("nav.scripts")</MudNavLink>
        <MudNavLink Href="/agents" Icon="@Icons.Material.Filled.SmartToy">@Loc.T("nav.agents")</MudNavLink>
        <MudNavLink Href="/secrets" Icon="@Icons.Material.Filled.Lock">@Loc.T("nav.secrets")</MudNavLink>
        <MudNavLink Href="/sync" Icon="@Icons.Material.Filled.Sync">@Loc.T("nav.sync")</MudNavLink>
        <MudNavLink Href="/audit" Icon="@Icons.Material.Filled.History">@Loc.T("nav.audit")</MudNavLink>
        <MudDivider Class="my-2" />
        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">@Loc.T("nav.settings")</MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    private bool _drawerOpen = true;
    private string ThemeIcon => AppState.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;

    protected override void OnInitialized() => AppState.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleLanguage() => AppState.ToggleLanguage();
    private void ToggleTheme() => AppState.SetDark(!AppState.IsDarkMode);

    public void Dispose() => AppState.Changed -= OnChanged;
}

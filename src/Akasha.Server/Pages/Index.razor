@page "/"
@inject IDbContextFactoryLike Db

<PageTitle>Akasha — Dashboard</PageTitle>

<MudGrid Spacing="3">
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h5" Color="Color.Primary">✦ Личное хранилище контекста</MudText>
            <MudText Typo="Typo.body2" Class="mt-2">
                Заметки, решения и источники о тебе и твоих проектах. AI-агенты читают, но меняют только через твоё одобрение.
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 d-flex flex-column gap-2">
            <MudText Typo="Typo.h6">Быстрые действия</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/entries/new">+ Новая запись</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/approvals">Очередь апрувов (@(_pending))</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/search">Поиск</MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Проекты</MudText>
            @if (_projects.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Пока пусто.</MudText>
            }
            else
            {
                <MudList T="string">
                    @foreach (var p in _projects)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Rounded.Folder" IconColor="Color.Primary">@p.Name</MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Последние записи</MudText>
            <MudList T="string">
                @foreach (var e in _entries)
                {
                    <MudListItem T="string" Icon="@KindIcon(e.Kind)" Caption="@e.Kind">
                        <MudLink Href="@($"/entries/{e.Id}")">@e.Title</MudLink>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<Project> _projects = new();
    private List<Entry> _entries = new();
    private int _pending;

    protected override async Task OnInitializedAsync()
    {
        await using var db = Db.Create();
        _projects = await db.Projects.OrderByDescending(p => p.UpdatedAt).Take(10).ToListAsync();
        _entries = await db.Entries.OrderByDescending(e => e.UpdatedAt).Take(10).ToListAsync();
        _pending = await db.Proposals.CountAsync(p => p.Status == ProposalStatus.Pending);
    }

    private static string KindIcon(string kind) => kind switch
    {
        "decision" => Icons.Material.Rounded.CheckCircle,
        "source" => Icons.Material.Rounded.Link,
        "snippet" => Icons.Material.Rounded.Code,
        "comment" => Icons.Material.Rounded.Chat,
        _ => Icons.Material.Rounded.Description,
    };
}

@page "/secrets"
@inject AkashaDbContext Db
@inject IConfiguration Cfg
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudText Typo="Typo.h5" GutterBottom="true">@Loc.T("page.secrets")</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    @((MarkupString)Loc.T("secrets.hint"))
</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_name" Label="@Loc.T("secrets.name")" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_value" Label="@Loc.T("secrets.value")" InputType="InputType.Password" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Lock" OnClick="AddSecret">@Loc.T("common.add")</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_secrets" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>@Loc.T("secrets.colName")</MudTh>
        <MudTh>@Loc.T("secrets.colUpdated")</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@Loc.T("secrets.colName")">@context.Name</MudTd>
        <MudTd DataLabel="@Loc.T("secrets.colUpdated")">@context.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       OnClick="@(() => Reveal(context))">@Loc.T("secrets.reveal")</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       OnClick="@(() => Remove(context.Id))">@Loc.T("common.delete")</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-visible="_revealOpen" Options="_dialogOpts">
    <TitleContent>@Loc.T("secrets.dialogTitle", _revealName)</TitleContent>
    <DialogContent>
        <MudTextField T="string" Value="@_revealValue" ReadOnly="true" Lines="2" Variant="Variant.Outlined"
                      Style="font-family: monospace;" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyValue">@Loc.T("common.copy")</MudButton>
        <MudButton OnClick="@(() => _revealOpen = false)">@Loc.T("common.close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Secret> _secrets = new();
    private string _name = "", _value = "";
    private bool _revealOpen;
    private string _revealName = "", _revealValue = "";
    private MudBlazor.DialogOptions _dialogOpts = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload() =>
        _secrets = await Db.Secrets.AsNoTracking().OrderBy(s => s.Name).ToListAsync();

    private async Task AddSecret()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_value))
        {
            Snackbar.Add(Loc.T("secrets.needNameValue"), Severity.Warning);
            return;
        }
        try
        {
            Db.Secrets.Add(new Secret
            {
                Name = _name,
                ValueEncrypted = SecretCrypto.Encrypt(_value, ApiEndpoints.MasterKey(Cfg)),
            });
            await Db.SaveChangesAsync();
            _name = _value = "";
            await Reload();
            Snackbar.Add(Loc.T("secrets.saved"), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Reveal(Secret s)
    {
        try
        {
            _revealName = s.Name;
            _revealValue = SecretCrypto.Decrypt(s.ValueEncrypted, ApiEndpoints.MasterKey(Cfg));
            _revealOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc.T("secrets.decryptFailed", ex.Message), Severity.Error);
        }
    }

    private async Task CopyValue()
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _revealValue);
        Snackbar.Add(Loc.T("secrets.copied"), Severity.Success);
    }

    private async Task Remove(Guid id)
    {
        var s = await Db.Secrets.FindAsync(id);
        if (s is not null) { Db.Secrets.Remove(s); await Db.SaveChangesAsync(); }
        await Reload();
        Snackbar.Add(Loc.T("secrets.deleted"), Severity.Info);
    }
}

@page "/secrets"
@inject AkashaDbContext Db
@inject IConfiguration Cfg
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudText Typo="Typo.h5" GutterBottom="true">@Loc.T("page.secrets")</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Значения шифруются AES-GCM. Секреты <b>никогда</b> не отдаются агентам и не синхронизируются.
    Ключ берётся из <code>AKASHA_MASTER_KEY</code> либо генерируется автоматически в <code>data/master.key</code>.
</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_name" Label="Имя (например, api-key-prod)" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_value" Label="Значение" InputType="InputType.Password" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Lock" OnClick="AddSecret">Добавить</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_secrets" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>Имя</MudTh>
        <MudTh>Обновлён</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Имя">@context.Name</MudTd>
        <MudTd DataLabel="Обновлён">@context.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       OnClick="@(() => Reveal(context))">Показать</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       OnClick="@(() => Remove(context.Id))">Удалить</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-visible="_revealOpen" Options="_dialogOpts">
    <TitleContent>Секрет: @_revealName</TitleContent>
    <DialogContent>
        <MudTextField T="string" Value="@_revealValue" ReadOnly="true" Lines="2" Variant="Variant.Outlined"
                      Style="font-family: monospace;" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyValue">Копировать</MudButton>
        <MudButton OnClick="@(() => _revealOpen = false)">Закрыть</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Secret> _secrets = new();
    private string _name = "", _value = "";
    private bool _revealOpen;
    private string _revealName = "", _revealValue = "";
    private MudBlazor.DialogOptions _dialogOpts = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload() =>
        _secrets = await Db.Secrets.AsNoTracking().OrderBy(s => s.Name).ToListAsync();

    private async Task AddSecret()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_value))
        {
            Snackbar.Add("Укажите имя и значение", Severity.Warning);
            return;
        }
        try
        {
            Db.Secrets.Add(new Secret
            {
                Name = _name,
                ValueEncrypted = SecretCrypto.Encrypt(_value, ApiEndpoints.MasterKey(Cfg)),
            });
            await Db.SaveChangesAsync();
            _name = _value = "";
            await Reload();
            Snackbar.Add("Секрет сохранён", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void Reveal(Secret s)
    {
        try
        {
            _revealName = s.Name;
            _revealValue = SecretCrypto.Decrypt(s.ValueEncrypted, ApiEndpoints.MasterKey(Cfg));
            _revealOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Не удалось расшифровать: {ex.Message}", Severity.Error);
        }
    }

    private async Task CopyValue()
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _revealValue);
        Snackbar.Add("Значение скопировано", Severity.Success);
    }

    private async Task Remove(Guid id)
    {
        var s = await Db.Secrets.FindAsync(id);
        if (s is not null) { Db.Secrets.Remove(s); await Db.SaveChangesAsync(); }
        await Reload();
        Snackbar.Add("Секрет удалён", Severity.Info);
    }
}

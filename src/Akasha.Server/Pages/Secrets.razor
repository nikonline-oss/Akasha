@page "/secrets"
@inject AkashaDbContext Db
@inject IConfiguration Cfg
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" GutterBottom="true">Секреты</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Значения шифруются AES-GCM (ключ — из <code>AKASHA_MASTER_KEY</code>). Секреты <b>никогда</b> не отдаются
    агентам и не синхронизируются.
</MudText>

@if (!_hasMasterKey)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        AKASHA_MASTER_KEY не задан — шифрование недоступно. Установите переменную окружения.
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_name" Label="Имя (например, api-key-prod)" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_value" Label="Значение" InputType="InputType.Password" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="@(!_hasMasterKey)" OnClick="AddSecret">Добавить</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="_secrets" Hover="true" Elevation="0">
    <HeaderContent>
        <MudTh>Имя</MudTh>
        <MudTh>Обновлён</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Имя">@context.Name</MudTd>
        <MudTd DataLabel="Обновлён">@context.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       OnClick="@(() => Remove(context.Id))">Удалить</MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Secret> _secrets = new();
    private string _name = "", _value = "";
    private bool _hasMasterKey;

    protected override async Task OnInitializedAsync()
    {
        _hasMasterKey = !string.IsNullOrEmpty(Cfg["AKASHA_MASTER_KEY"] ?? Environment.GetEnvironmentVariable("AKASHA_MASTER_KEY"));
        await Reload();
    }

    private async Task Reload() =>
        _secrets = await Db.Secrets.AsNoTracking().OrderBy(s => s.Name).ToListAsync();

    private async Task AddSecret()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_value)) return;
        var key = SecretCrypto.DeriveKeyFromMasterKey(
            Cfg["AKASHA_MASTER_KEY"] ?? Environment.GetEnvironmentVariable("AKASHA_MASTER_KEY")!);
        Db.Secrets.Add(new Secret
        {
            Name = _name,
            ValueEncrypted = SecretCrypto.Encrypt(_value, key),
        });
        await Db.SaveChangesAsync();
        _name = _value = "";
        await Reload();
        Snackbar.Add("Секрет сохранён", Severity.Success);
    }

    private async Task Remove(Guid id)
    {
        var s = await Db.Secrets.FindAsync(id);
        if (s is not null) { Db.Secrets.Remove(s); await Db.SaveChangesAsync(); }
        await Reload();
    }
}

@page "/graph"
@inject IDbContextFactoryLike Dbf
@inject IJSRuntime JsRuntime
@inject NavigationManager Nav
@implements IAsyncDisposable

<MudText Typo="Typo.h5" GutterBottom="true">@Loc.T("page.graph")</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
    Узлы — записи, рёбра — связи (mentions / supersedes / contradicts / derived_from). Перетаскивай и масштабируй; клик по узлу открывает запись.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_nodes.Count == 0)
{
    <MudAlert Severity="Severity.Info">Нет записей для отображения графа.</MudAlert>
}
else
{
    <MudPaper Class="pa-2" Elevation="1">
        <div id="graph-container" style="width:100%; height:70vh; min-height:420px;"></div>
    </MudPaper>
}

<div class="d-flex gap-4 mt-3 flex-wrap">
    @foreach (var k in EntryKinds.All)
    {
        <div class="d-flex align-center gap-1">
            <MudIcon Icon="@Icons.Material.Filled.Circle" Style="@($"color:{KindColor(k)}")" Size="Size.Small" />
            <MudText Typo="Typo.body2">@k</MudText>
        </div>
    }
</div>

@code {
    private sealed record GraphNode(Guid Id, string Title, string Kind);
    private sealed record GraphEdge(Guid From, Guid To, string Relation);

    private bool _loading = true;
    private List<GraphNode> _nodes = new();
    private List<GraphEdge> _edges = new();
    private DotNetObjectReference<Graph>? _ref;

    protected override async Task OnInitializedAsync()
    {
        using var db = Dbf.Create();
        var entries = await db.Entries.AsNoTracking()
            .Where(e => e.DeletedAt == null)
            .OrderByDescending(e => e.UpdatedAt)
            .Take(120)
            .Select(e => new { e.Id, e.Title, e.Kind })
            .ToListAsync();

        var ids = entries.Select(e => e.Id).ToHashSet();
        _nodes = entries.Select(e => new GraphNode(e.Id, e.Title, e.Kind)).ToList();

        var links = await db.EntryLinks.AsNoTracking().ToListAsync();
        _edges = links
            .Where(l => ids.Contains(l.FromId) && ids.Contains(l.ToId))
            .Select(l => new GraphEdge(l.FromId, l.ToId, l.Relation))
            .ToList();

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loading || _nodes.Count == 0) return;

        _ref ??= DotNetObjectReference.Create(this);
        var elements = new
        {
            nodes = _nodes.Select(n => new
            {
                data = new { id = n.Id.ToString(), label = Trunc(n.Title, 32), color = KindColor(n.Kind) }
            }).ToList(),
            edges = _edges.Select(e => new
            {
                data = new
                {
                    id = $"{e.From}-{e.To}-{e.Relation}",
                    source = e.From.ToString(),
                    target = e.To.ToString(),
                    relation = e.Relation
                }
            }).ToList()
        };

        try
        {
            await JsRuntime.InvokeVoidAsync("akashaGraph.init", "graph-container", elements, _ref);
        }
        catch (InvalidOperationException)
        {
            // Статическая предварительная отрисовка (prerender): JS ещё недоступен.
            // Интерактивный клиентский рендер вызовет OnAfterRenderAsync повторно.
        }
    }

    [JSInvokable]
    public Task OpenEntry(Guid id)
    {
        Nav.NavigateTo($"/entries/{id}");
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        _ref?.Dispose();
        await ValueTask.CompletedTask;
    }

    private static string KindColor(string kind) => kind switch
    {
        EntryKinds.Note => "#6C3FC5",
        EntryKinds.Decision => "#C9A227",
        EntryKinds.Source => "#2E8B57",
        EntryKinds.Comment => "#4682B4",
        EntryKinds.Snippet => "#B44B4B",
        _ => "#888888",
    };

    private static string Trunc(string s, int max) => s.Length <= max ? s : s[..max] + "…";
}
